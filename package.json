{
  "name": "digitales-rezeptbuch",
  "private": true,
  "type": "module",
  "version": "0.1.0",
  "workspaces": [
    "apps/*", "packages/*"
  ],
  "scripts": {
    "postinstall": "npm run build --workspace @rezeptbuch/chatgpt-local",
    "build:chatgpt": "npm run build --workspace @rezeptbuch/chatgpt-local",
    "test:chatgpt": "npm run test --workspace @rezeptbuch/chatgpt-local",
    "dev": "npm run dev --workspace @rezeptbuch/web",
    "build": "npm run build --workspace @rezeptbuch/web && node scripts/build-offline.mjs",
    "build:pages": "node scripts/build-pages.mjs",
    "typecheck:pages": "tsc --noEmit -p apps/pages/tsconfig.json",
    "test:pages": "playwright test --config playwright.pages.config.ts",
    "start": "npm run start --workspace @rezeptbuch/web",
    "typecheck": "npm run typecheck --workspace @rezeptbuch/web",
    "test": "node --experimental-strip-types --test apps/web/src/lib/*.test.ts",
    "test:e2e": "playwright test",
    "test:server": "node --experimental-strip-types --test tests/server/*.test.mjs",
    "test:postgres": "node --experimental-strip-types tests/server/postgres-integration.mjs",
    "test:server:integration": "node --experimental-strip-types tests/server/private-integration.mjs",
    "start:private": "node --experimental-strip-types scripts/start-private-server.mjs",
    "worker": "node --env-file-if-exists=apps/web/.env.local --experimental-strip-types apps/worker/worker.ts",
    "worker:abo": "node --env-file-if-exists=apps/web/.env.local --experimental-strip-types apps/worker/abo-worker.ts",
    "abo": "node scripts/start-abo.mjs",
    "abo:start": "node scripts/start-abo.mjs --production",
    "typecheck:worker": "tsc --noEmit --module nodenext --moduleResolution nodenext --target es2022 --allowImportingTsExtensions --skipLibCheck apps/worker/worker.ts apps/worker/abo-worker.ts"
  },
  "engines": {
    "node": ">=24.0.0"
  },
  "devDependencies": {
    "@playwright/test": "1.64.1",
    "vite": "8.3.5"
  }
}
