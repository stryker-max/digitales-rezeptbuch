# Optional local analysis. Copy to apps/web/.env.local; never commit secrets.
LOCAL_ANALYSIS_ENABLED=false
OPENAI_API_KEY=
# Explicit vision model supporting Responses + Structured Outputs. No automatic model choice.
OPENAI_MODEL=
# Absolute private directory. Example Windows path (forward slashes):
RECIPE_DATA_DIR="C:/Users/marku/Documents/Projekte/Digitales Rezeptbuch/private/analysis"
# Maximum reserved calls per UTC day across all workers; not a monetary cost cap.
ANALYSIS_DAILY_CALL_LIMIT=5
